<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Study Schedule"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".AdminActivity" android:exported="false"/>
        <activity android:name=".StudentActivity" android:exported="false"/>
        <activity android:name=".SubjectActivity" android:exported="false"/>
        <activity android:name=".StudentHomeActivity" android:exported="false"/>
        <activity android:name=".ScheduleActivity" android:exported="false"/>
        <activity android:name=".CalendarActivity" android:exported="false"/>
        <receiver android:name=".ReminderReceiver" android:exported="false"/>
    </application>
</manifest>
